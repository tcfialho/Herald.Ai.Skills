{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent result-only pairwise judge",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verdict": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "TIE",
        "UNCERTAIN"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "comparison": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "TIE",
              "UNCERTAIN"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 8
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "criterion_id",
          "comparison",
          "observation",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "retained_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_next_test": {
      "type": "string"
    },
    "quality_by_label": {
      "type": "object",
      "properties": {
        "A": {
          "type": "object",
          "properties": {
            "quality_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "minor",
                      "medium",
                      "major",
                      "critical"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 12
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "severity",
                  "description",
                  "evidence_ids"
                ],
                "additionalProperties": false
              }
            },
            "case_observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string"
                  },
                  "worst_severity": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minor",
                      "medium",
                      "major",
                      "critical"
                    ]
                  },
                  "observation": {
                    "type": "string",
                    "minLength": 12
                  }
                },
                "required": [
                  "case_id",
                  "worst_severity",
                  "observation"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "quality_findings",
            "case_observations"
          ],
          "additionalProperties": false
        },
        "B": {
          "type": "object",
          "properties": {
            "quality_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "minor",
                      "medium",
                      "major",
                      "critical"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "minLength": 12
                  },
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "severity",
                  "description",
                  "evidence_ids"
                ],
                "additionalProperties": false
              }
            },
            "case_observations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "case_id": {
                    "type": "string"
                  },
                  "worst_severity": {
                    "type": "string",
                    "enum": [
                      "none",
                      "minor",
                      "medium",
                      "major",
                      "critical"
                    ]
                  },
                  "observation": {
                    "type": "string",
                    "minLength": 12
                  }
                },
                "required": [
                  "case_id",
                  "worst_severity",
                  "observation"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "quality_findings",
            "case_observations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_ids",
    "verdict",
    "confidence",
    "criteria",
    "retained_strengths",
    "material_regressions",
    "uncertainties",
    "suggested_next_test"
  ],
  "additionalProperties": false
}
